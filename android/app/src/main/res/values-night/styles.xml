<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#111317</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/hotaru_splash</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111317</item>
        <item name="android:navigationBarColor">#111317</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#111317</item>
    </style>
    <style name="TransparentTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
